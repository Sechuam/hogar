# Copia este fichero a .env (ignorado por git) y rellena los valores.
# Lo leen tanto Docker Compose como la aplicación (spring.config.import).

# --- Base de datos ---
DB_NAME=hogar
DB_USERNAME=hogar
DB_PASSWORD=cambia-esto
DB_URL=jdbc:postgresql://localhost:5432/hogar
DB_PORT=5432

# --- Aplicación ---
SERVER_PORT=8080
# Puerto de Actuator (health, info, metrics, prometheus). No se publica en Docker Compose.
MANAGEMENT_PORT=8081
# Perfil en local (./mvnw spring-boot:run): 'dev' = logs legibles. Otro perfil = logs JSON (ECS).
SPRING_PROFILES_ACTIVE=dev
# Perfil de la app dentro de Docker Compose (por defecto 'docker': logs JSON).
DOCKER_SPRING_PROFILES=docker

# --- Seguridad (Fase 1) ---
# Secreto HMAC para firmar los JWT: mínimo 32 bytes aleatorios. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=
# Client IDs de Google (separados por comas) aceptados como 'aud' del ID token.
GOOGLE_CLIENT_IDS=
# Orígenes de navegador permitidos por CORS, separados por comas (vacío = ninguno, D-069).
# Para el cliente Flutter web en desarrollo (flutter run -d chrome --web-port 5000):
#   CORS_ALLOWED_ORIGINS=http://localhost:5000
CORS_ALLOWED_ORIGINS=

# --- Facturas (Fase 4) ---
# Directorio donde se guardan los adjuntos (relativo al directorio de trabajo o absoluto).
STORAGE_DIR=./storage
