### El alquiler conserva su reparto proporcional (snapshot) -> 200
GET {{baseUrl}}/api/households/{{householdId}}/expenses/{{rentExpenseId}}
Authorization: Bearer {{martaToken}}

> {%
    client.test("snapshot", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.splitPolicyApplied === "PROPORTIONAL", "política");
    });
%}

### Gastos de marzo (alquiler, compra e internet), paginados (size máx. 100) -> 200
GET {{baseUrl}}/api/households/{{householdId}}/expenses?from=2026-03-01&to=2026-03-31&page=0&size=20
Authorization: Bearer {{anaToken}}

> {%
    client.test("listado 200", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.totalElements === 3, "gastos " + response.body.totalElements);
    });
%}

### Luis corrige la descripción de su compra: no cambia importe ni fecha, no se recalcula -> 200
PUT {{baseUrl}}/api/households/{{householdId}}/expenses/{{groceriesExpenseId}}
Authorization: Bearer {{luisToken}}
Content-Type: application/json

{
  "amount": 84.37,
  "description": "Compra semanal (Mercadona)",
  "category": "GROCERIES",
  "date": "2026-03-15"
}

> {%
    client.test("PUT 200", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.splitPolicyApplied === "PROPORTIONAL", "reparto conservado");
    });
%}

### Marta no pagó ni creó el alquiler y no es OWNER -> 403 expense-edit-forbidden
DELETE {{baseUrl}}/api/households/{{householdId}}/expenses/{{rentExpenseId}}
Authorization: Bearer {{martaToken}}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("403 expense-edit-forbidden", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(body.code === "expense-edit-forbidden", "code " + body.code);
    });
%}

### Validación: 3 decimales y descripción en blanco -> 400 validation-error con un error por campo
POST {{baseUrl}}/api/households/{{householdId}}/expenses
Authorization: Bearer {{anaToken}}
Content-Type: application/json

{
  "amount": 12.345,
  "description": "   ",
  "category": "OTHER",
  "date": "2026-03-10"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("400 validation-error", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(body.code === "validation-error", "code " + body.code);
        client.assert(body.errors.length === 2, "errors " + JSON.stringify(body.errors));
    });
%}

### Un tipo incorrecto (enum desconocido) también es validation-error del campo (D-029) -> 400
POST {{baseUrl}}/api/households/{{householdId}}/expenses
Authorization: Bearer {{anaToken}}
Content-Type: application/json

{
  "amount": 10.00,
  "description": "Categoría inventada",
  "category": "CASINO",
  "date": "2026-03-10"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("400 validation-error en category", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(body.errors[0].field === "category", "campo " + body.errors[0].field);
    });
%}

### Fecha fuera de 0001..9999 -> 400 validation-error del campo date (D-047)
POST {{baseUrl}}/api/households/{{householdId}}/expenses
Authorization: Bearer {{anaToken}}
Content-Type: application/json

{
  "amount": 10.00,
  "description": "Gasto del año 10000",
  "category": "OTHER",
  "date": "10000-01-01"
}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
%}
