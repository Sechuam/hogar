### Registro con un email ya usado -> 409 email-already-registered (ProblemDetail)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "{{anaEmail}}",
  "password": "otra-contrasena-cualquiera",
  "displayName": "Ana bis"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("409 email-already-registered", () => {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(body.code === "email-already-registered", "code " + body.code);
    });
%}

### Login de Ana -> 200 (el X-Request-Id que envíes vuelve en la respuesta y en los logs)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-Request-Id: demo-login-ana

{
  "email": "{{anaEmail}}",
  "password": "contrasena-de-prueba-1"
}

> {%
    client.test("login 200", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("X-Request-Id") === "demo-login-ana", "X-Request-Id");
    });
    client.global.set("anaToken", response.body.accessToken);
    client.global.set("anaRefresh", response.body.refreshToken);
%}

### Contraseña errónea -> 401 invalid-credentials (mismo error si el email no existe)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{anaEmail}}",
  "password": "no-es-esta"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    client.test("401 invalid-credentials", () => {
        client.assert(response.status === 401, "status " + response.status);
        client.assert(body.code === "invalid-credentials", "code " + body.code);
    });
%}

### Usuario autenticado -> 200
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{anaToken}}

> {%
    client.test("me 200", () => client.assert(response.status === 200, "status " + response.status));
%}

### Sin token -> 401 unauthorized (también como ProblemDetail, con requestId)
GET {{baseUrl}}/api/users/me

> {%
    client.test("401 sin token", () => client.assert(response.status === 401, "status " + response.status));
%}

### Refresh: rota el refresh token (el anterior deja de valer) -> 200
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{anaRefresh}}"
}

> {%
    client.test("refresh 200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("anaRefreshOld", client.global.get("anaRefresh"));
    client.global.set("anaRefresh", response.body.refreshToken);
    client.global.set("anaToken", response.body.accessToken);
%}

### Reutilizar el refresh ya rotado -> 401 invalid-refresh-token y se revoca toda la familia (D-022)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{anaRefreshOld}}"
}

> {%
    client.test("reutilización 401", () => client.assert(response.status === 401, "status " + response.status));
%}

### El refresh vigente de esa familia también ha quedado revocado -> 401
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{anaRefresh}}"
}

> {%
    client.test("familia revocada 401", () => client.assert(response.status === 401, "status " + response.status));
%}

### Logout: idempotente, siempre 204
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{anaRefresh}}"
}

> {%
    client.test("logout 204", () => client.assert(response.status === 204, "status " + response.status));
%}

